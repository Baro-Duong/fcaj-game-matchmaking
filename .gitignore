# .gitignore ở GỐC repo. Project Unity nằm trong unity/ nên mọi đường dẫn Unity có tiền tố unity/.
# Dựa trên https://github.com/github/gitignore/blob/main/Unity.gitignore

# ===== Unity: thư mục sinh tự động =====
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/
unity/.utmp/
unity/UIElementsSchema/
unity/ServerData/

# ===== Unity: file IDE / solution sinh tự động =====
unity/*.csproj
unity/*.sln
unity/*.slnx
unity/*.unityproj
unity/*.suo
unity/*.tmp
unity/*.pidb
unity/*.booproj
unity/*.svd
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ===== Unity: file sinh trong Assets =====
unity/[Aa]ssets/Plugins/Editor/JetBrains*
unity/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
unity/[Aa]ssets/[Ss]ceneDependencyCache*
unity/[Aa]ssets/StreamingAssets/aa*
unity/[Aa]ssets/AddressableAssetsData/link.xml*
unity/[Aa]ssets/AddressableAssetsData/*/*.bin*
unity/[Aa]ssets/Addressables_Temp*
unity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db*
unity/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers*

# ===== Unity: crash / log =====
unity/sysinfo.txt
unity/mono_crash.*
unity/crashlytics-build.properties
*.log
*.blend1
*.blend1.meta

# ===== IDE =====
.vs/
.vscode/
.idea/
.gradle/
.consulo/
*.user
*.userprefs
*.DotSettings.user

# ===== Bản build / gói nén (build server đưa lên S3, không vào git) =====
*.unitypackage
*.unitypackage.meta
*.apk
*.aab
*.app
*.zip

# ===== Node.js (Lambda, bot) / IaC =====
node_modules/
cdk.out/

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== BÍ MẬT: không bao giờ commit =====
*.pem
*.ppk
*.key
.env
.env.*
!.env.example
# Cấu hình client chứa API URL thật; commit bản client-config.example.json thay thế
unity/Assets/StreamingAssets/client-config.json
